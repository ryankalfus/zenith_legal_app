    "review::.::holistic::high_level_elegance::auth_provider_overloaded_domain_orchestrator::6eab471a": {
      "id": "review::.::holistic::high_level_elegance::auth_provider_overloaded_domain_orchestrator::6eab471a",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "AuthContext has accumulated multiple domain responsibilities beyond session state ownership.",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "apps/mobile/src/state/AuthContext.tsx",
          "functions/src/callable/ensureZenithAdmin.ts",
          "functions/src/config/env.ts"
        ],
        "evidence": [
          "AuthContext.tsx handles auth subscription, first-time user provisioning, admin claim synchronization, admin role correction, and push-token writes.",
          "These concerns span identity, authorization, profile lifecycle, and notifications, but they are orchestrated in a single provider hook.",
          "Backend callables already implement role orchestration, yet AuthContext duplicates reconciliation behavior at app state layer."
        ],
        "suggestion": "Split AuthContext into focused collaborators (session observer, profile bootstrap service, admin-role reconciler, push registration service) and keep provider limited to composition and exposed session API.",
        "reasoning": ""
      },
