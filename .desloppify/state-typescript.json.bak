    "review::.::holistic::authorization_consistency::admin_claim_depends_on_email_string_only::31c2643e": {
      "id": "review::.::holistic::authorization_consistency::admin_claim_depends_on_email_string_only::31c2643e",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Admin claim issuance relies on matching email string, without stronger identity checks like verified-email enforcement.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "functions/src/callable/ensureZenithAdmin.ts",
          "functions/src/callable/adminRole.ts",
          "apps/mobile/src/state/AuthContext.tsx",
          "apps/admin/src/lib/auth.ts",
          "apps/mobile/src/screens/AuthScreen.tsx",
          "apps/admin/app/auth/page.tsx"
        ],
        "evidence": [
          "`ensureZenithAdminClaim` grants admin if `request.auth.token.email` equals configured admin email, but does not check `email_verified`.",
          "`setAdminRoleByEmail` authorization also depends on requester email string and target email string matching allowlists/config.",
          "Both mobile and admin web auth flows allow self-service signup, then immediately attempt admin bootstrap based on email match."
        ],
        "suggestion": "Move admin elevation to a hardened server path that requires verified identity (for example `email_verified === true` plus controlled bootstrap flow), and stop using client-side email match as an admin gate.",
