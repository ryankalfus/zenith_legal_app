    "review::.::holistic::authorization_consistency::triggers_trust_client_written_actor_role_fields::2f426001": {
      "id": "review::.::holistic::authorization_consistency::triggers_trust_client_written_actor_role_fields::2f426001",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Backend triggers treat client-written actor-role fields as authority, which can desynchronize authorization intent from actual actor identity.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "functions/src/triggers/appointmentPush.ts",
          "functions/src/triggers/messagePush.ts",
          "apps/mobile/src/services/appointmentService.ts",
          "apps/mobile/src/services/messagingService.ts"
        ],
        "evidence": [
          "`sendPushOnAppointmentChange` gates behavior on `after.updatedByRole === \"admin\"`, where `updatedByRole` is written from client payloads.",
          "`sendPushOnMessageCreate` gates behavior on `message.senderRole === \"admin\"`, where `senderRole` is also client-supplied in `sendMessage`.",
          "This pattern relies on document field integrity rather than server-derived actor identity."
        ],
        "suggestion": "Derive actor role server-side (callable context auth or trusted server writes), and treat role fields in documents as display metadata only, not authorization signals.",
        "reasoning": ""
      },
