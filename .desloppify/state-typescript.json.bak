    "review::.::holistic::error_consistency::silent_failure_pathways::93e475d7": {
      "id": "review::.::holistic::error_consistency::silent_failure_pathways::93e475d7",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Critical auth/data operations frequently swallow errors and continue with degraded state",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "apps/admin/src/lib/auth.ts",
          "apps/mobile/src/screens/MessagesScreen.tsx",
          "apps/mobile/src/services/userService.ts"
        ],
        "evidence": [
          "Auth flows suppress callable/token/doc write errors with `.catch(() => undefined)` and continue.",
          "Message read side effects are fired and silently ignored (`markConversationRead(...).catch(() => undefined)`), making delivery/read failures invisible.",
          "Storage delete and other mutations often ignore failures, producing inconsistent post-conditions."
        ],
        "suggestion": "Adopt a single boundary error policy: either propagate typed errors to UI/retry handlers or log-and-surface an explicit degraded-state flag. Replace silent catches in auth/session paths with structured `Result`/error objects and central telemetry.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
