      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Appointment screen logic is duplicated across candidate and admin flows instead of sharing a common workflow model.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "apps/mobile/src/screens/candidate/CandidateAppointmentsScreen.tsx",
          "apps/mobile/src/screens/admin/AdminAppointmentRequestsScreen.tsx",
          "apps/mobile/src/services/appointmentService.ts"
        ],
        "evidence": [
          "Both screens define local date/time helpers (`formatDate`, `formatTime`) and transform date+time into ISO (`startsAtIso` via memo vs `mergeDateAndTime`) with similar validation/alerts.",
