    "review::.::holistic::cross_module_architecture::split_admin_policy_between_client_and_backend::864d4670": {
      "id": "review::.::holistic::cross_module_architecture::split_admin_policy_between_client_and_backend::864d4670",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Admin role policy is fragmented across client and backend with different config sources and overlapping authority.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "apps/mobile/src/state/AuthContext.tsx",
          "functions/src/config/env.ts",
          "functions/src/callable/ensureZenithAdmin.ts",
          "functions/src/callable/adminRole.ts"
        ],
        "evidence": [
          "AuthContext.tsx derives admin status from EXPO_PUBLIC_ZENITH_ADMIN_EMAIL and updates user role docs client-side.",
          "functions/src/config/env.ts derives backend admin policy from ZENITH_ADMIN_EMAIL and SUPER_ADMIN_EMAILS.",
          "ensureZenithAdminClaim and setAdminRoleByEmail both assign admin claims/server docs, producing multiple authority paths for the same role decision."
        ],
        "suggestion": "Centralize admin-eligibility decisions server-side only: make client treat role as read-only, expose one callable for reconciliation, and share one config key contract across mobile/functions to remove divergent policy logic.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
