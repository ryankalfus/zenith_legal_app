    "review::.::holistic::cross_module_architecture::conversation_contract_scattered_across_features::08430a5a": {
      "id": "review::.::holistic::cross_module_architecture::conversation_contract_scattered_across_features::08430a5a",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Conversation storage schema and lifecycle rules are duplicated across messaging and account-deletion paths.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "apps/mobile/src/services/messagingService.ts",
          "functions/src/callable/deleteAccount.ts"
        ],
        "evidence": [
          "messagingService.ts writes many conversation fields (visibility flags, unread counters, preview fields, participantIds) and message attachment paths.",
          "deleteAccount.ts hardcodes deletion traversal for conversations/{candidateId}/messages and messageAttachments/{candidateId}/, tightly coupling cleanup to client schema details.",
          "No shared schema/contract module exists in the assigned files to make these assumptions explicit and versioned."
        ],
        "suggestion": "Create a shared conversation domain contract (field names + path builders + lifecycle helpers) used by both mobile services and functions cleanup logic, then route destructive cleanup through a domain service instead of raw hardcoded paths.",
        "reasoning": ""
      },
      "status": "auto_resolved",
