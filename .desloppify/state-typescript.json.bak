    "review::.::holistic::cross_module_architecture::import_time_firebase_bootstrap_coupling::450bfada": {
      "id": "review::.::holistic::cross_module_architecture::import_time_firebase_bootstrap_coupling::450bfada",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Global Firebase initialization and emulator wiring at import time creates hidden startup coupling across mobile modules.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "apps/mobile/src/lib/firebase.ts",
          "apps/mobile/src/state/AuthContext.tsx",
          "apps/mobile/src/services/userService.ts",
          "apps/mobile/src/services/messagingService.ts",
          "apps/mobile/src/services/adminService.ts"
        ],
        "evidence": [
          "apps/mobile/src/lib/firebase.ts executes initializeApp(...) and connect*Emulator(...) in module scope.",
          "Multiple service/context modules directly import exported singletons (auth/db/storage/functions), so importing a service implicitly performs runtime configuration work.",
          "This pattern makes boot behavior environment-dependent and hard to isolate in tests because module import triggers side effects."
        ],
        "suggestion": "Introduce a Firebase runtime boundary (e.g., createFirebaseClients/getFirebaseClients) initialized once from app entry, then inject clients into services/context or expose a lazily initialized accessor with explicit bootstrap call.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
      "first_seen": "2026-02-27T04:17:56+00:00",
      "last_seen": "2026-02-27T04:17:56+00:00",
      "resolved_at": "2026-02-27T04:24:20+00:00",
      "reopen_count": 0,
      "lang": "typescript",
