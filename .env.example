# CLI/runtime helpers (used by scripts + local Firebase tooling)
FIREBASE_PROJECT_ID=zenith-legal-dev
JAVA_HOME=/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home
NODE_EXTRA_CA_CERTS=

# Shared Firebase project config (mobile + admin)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Admin console access
NEXT_PUBLIC_ADMIN_ALLOWLIST=mason@zenithlegal.com

# Mobile contact CTAs
EXPO_PUBLIC_MASON_PHONE=+15551234567
EXPO_PUBLIC_MASON_EMAIL=mason@zenithlegal.com

# Functions admin role bootstrap
SUPER_ADMIN_EMAILS=mason@zenithlegal.com
